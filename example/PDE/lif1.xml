		<Wall mask="ALL">
            <Box nx="1"/><Box dx="-1"/>
            <Box ny="1"/><Box dy="-1"/>
            <Box nz="1"/><Box dz="-1"/>
		</Wall>
	</Geometry>
	<Model>
		<Param name="Source" value="1.0/m3s" zone="source"/>
	</Model>
	<VTK/>
	<VTK Iterations="0.1s"/>
	<Solve Iterations="1s"/>
</CLBConfig>
