<?xml version="1.0"?>
<CLBConfig version="2.0" output="output/">
	<Units>
		<Param value="0.1m" gauge="128"/>
		<Param value="9.81m/s2" gauge="2.5e-6"/>
		<Param value="1000kg/m3" gauge="1"/>
