		<!-- 1e-6m2/s 0.02s/m2-->
		<Param name="NablaPX" value="10000Pa/m"/>
	</Model>
	<VTK/>
	<VTK Iterations="100"/>
	<Solve Iterations="1000"/>
	<Param name="VolumeFraction" value="0.0" zone="inletpatch"/>
