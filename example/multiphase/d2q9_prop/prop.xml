	<Geometry nx="256" ny="128">
		<MRT><Box/></MRT>
		<None name="inletpatch"><Box nx="16" ny="16" dx="0" dy="64"/></None>
		<!-- <None name="patch"><Box nx="64" ny="64" dx="128" dy="32"/></None> -->
		<None name="patch"><Box ny="64"/></None>
<!--		<WPressure><Box nx="1"/></WPressure>
		<EPressure><Box dx="-1"/></EPressure>
		<Wall>
			<Box nx="16" ny="16" dx="32" dy="32"/>
			<Box ny="1"/>
			<Box dy="-1"/>
		</Wall> -->
