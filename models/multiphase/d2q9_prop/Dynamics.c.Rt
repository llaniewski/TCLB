<?R
	source("conf.R") 
	source("lib/feq.R")
	source("lib/boundary.R")

    u = PV("u", xy)
    htot = PV("htot")
    v = PV("v", xy)
    gtot = PV("gtot")

	H = PV("H")
    um = PV("um", xy)
	
	g = PV(Density$name[Density$group=='g'])
    h = PV(Density$name[Density$group=='h'])
    f = g + h

    EQ = MRT_eq(U, rho=H, J=H*um, ortogonal=FALSE)

    vf = PV("vf")

    EQh = MRT_eq(U, rho=htot, J=htot*u, ortogonal=FALSE)
    EQg = MRT_eq(U, rho=gtot, J=gtot*v, ortogonal=FALSE)

    R = PV("R",1:9-1)
    Rh = PV("Rh",1:9-1)
    Rg = PV("Rg",1:9-1)
?>

CudaDeviceFunction real_t getH(){
	return <?R C(sum(f)) ?> ;
}
    
CudaDeviceFunction real_t getVF(){
	return (<?R C(sum(h)) ?>) / (<?R C(sum(f)) ?>) ;
}

CudaDeviceFunction vector_t getU(){
	real_t d = <?R C(sum(f)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), f %*% U * PV("d")^{-1}) ?>
    u.x += GravitationX * 0.5;
    u.y += GravitationY * 0.5;
	return u;
}


CudaDeviceFunction vector_t getUf(){
	real_t d = <?R C(sum(g)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), g %*% U * PV("d")^{-1}) ?>
	return u;
}

CudaDeviceFunction vector_t getUs(){
	real_t d = <?R C(sum(h)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), h %*% U * PV("d")^{-1}) ?>
	return u;
}


CudaDeviceFunction float2 Color() {
    float2 ret;
    vector_t u = getU();
    ret.x = sqrt(u.x*u.x + u.y*u.y);
    ret.y = 1.0 - getVF();
    return ret;
}

CudaDeviceFunction void SetEquilibrum(real_t H, real_t umx, real_t umy, real_t vf) {
    real_t <?R C(R,sep=", ") ?>;
<?R
    C(R, EQ$Req)
	C(g, R %*% solve(EQ$mat) * (1-vf))
    C(h, R %*% solve(EQ$mat) * vf)
?>
}

CudaDeviceFunction void Init() {
	real_t H = (1+Pressure*3);
	real_t umx = VelocityX;
	real_t umy = VelocityY;
    real_t vf = VolumeFraction; 
	SetEquilibrum(H, umx, umy, vf);
}

CudaDeviceFunction void Run() {
    switch (NodeType & NODE_BOUNDARY) {
	case NODE_WVelocity:
		WVelocity();
		break;
	case NODE_EPressure:
		EPressure();
		break;
    }
    switch (NodeType & NODE_COLLISION) {
    case NODE_Wall:
        BounceBack();
        break;
    case NODE_MRT:
		CollisionMRT();
        break;
    }
}

CudaDeviceFunction void BounceBack()
{
<?R FullBounceBack() ?>
}


<?R 
    EQ_b = MRT_eq(U[,1:2])
    ftmp = PV("f",i9)
?>

CudaDeviceFunction void WVelocity() {
    real_t <?R C(ftmp, sep=", ") ?>;
    real_t vf = VolumeFraction;
<?R 
    C(ftmp, g+h)
    ZouHeRewrite(EQ_b, ftmp, c(-1,0), type="velocity", PV("Velocity",c("X","Y")))
    sel = as.vector(U %*% c(-1,0,0) < 0)
    C(g[sel],(ftmp * (1-vf))[sel])
    C(h[sel],(ftmp * vf)[sel])
?>
}

CudaDeviceFunction void EPressure() {
    real_t <?R C(ftmp, sep=", ") ?>;
    real_t vf = VolumeFraction;
<?R 
    C(ftmp, g+h)
    ZouHeRewrite(EQ_b, ftmp, c(1,0), type="pressure")
    sel = as.vector(U %*% c(1,0,0) < 0)
    C(g[sel],(ftmp * (1-vf))[sel])
    C(h[sel],(ftmp * vf)[sel])
?>
}


CudaDeviceFunction void CollisionMRT()
{
<?R
    omega = PV("omega")
    # M = EQ$mat
    # C( Rg, g %*% M )
    # C( Rh, h %*% M )
    # C( R, Rg + Rh )
    # C( H, Rg[1] + Rh[1])
    # C( um, (Rg[2:3] + Rh[2:3])*H^{-1})
    # C( vf, Rh[1]*H^{-1})
    # C( R, EQ$Req)
    # C( Rg, Rg - R*(1-vf))
    # C( Rh, Rh - R*vf)
    # C( Rg, Rg * omega)
    # C( Rh, Rh * omega)
    # C( Rg, Rg + R*(1-vf))
    # C( Rh, Rh + R*vf)
    # C( g, Rg %*% solve(M) )
    # C( h, Rh %*% solve(M) )

    Z = matrix(0,nrow(EQ$mat),ncol(EQ$mat))
    M = rbind(cbind(EQ$mat,Z),cbind(Z,EQ$mat))
    gh = V(g,h)
    Rgh = V(Rg,Rh)
    gJ = PV("gJ",xy)
    hJ = PV("hJ",xy)
    Rgh[1] = gtot
    Rgh[2:3] = gJ
    Rgh[1+9] = htot
    Rgh[2:3+9] = hJ
    Rgheq = EQ$Req
    ghvf = htot * H^{-1}
    ghum = (gJ + hJ) * H^{-1}
    Rgheq = subst(V(EQ$Req*(1-ghvf),EQ$Req*ghvf), H=gtot+htot, umx=ghum[1], umy=ghum[2])
    Rgheq[2:3] = gJ
    Rgheq[2:3+9] = hJ
    ngJ = PV("ngJ",xy)
    nhJ = PV("nhJ",xy)
    # nRgheq = Rgheq
    nRgheq = subst(Rgheq, gJx=ngJ[1], gJy=ngJ[2], hJx=nhJ[1], hJy=nhJ[2])
    F = PV("F",xy)
?>
    
    real_t <?R C(Rgh,sep=",") ?>;
    real_t omega = 1.0 - 1.0/(3*Viscosity + 0.5);
    real_t H, vf, umx, umy;
    real_t <?R C(V(ngJ,nhJ),sep=",") ?>;
    real_t <?R C(F,sep=",") ?>;
<?R
    C( Rgh, gh %*% M )
    C( H, gtot + htot )
    C( um, (gJ + hJ) * H^{-1} )
    #C( ngJ, um * gtot )
    #C( nhJ, um * htot )
    #C( ngJ, omega*gJ + ( 1 - omega )*um*gtot)
    #C( nhJ, omega*hJ + ( 1 - omega )*um*htot )
    C( F, (hJ*gtot - gJ*htot) * H^{-1})
    C( ngJ, gJ + ( 1 - omega )*F)
    C( nhJ, hJ - ( 1 - omega )*F)
    C( Rgh, (Rgh - Rgheq)*omega + nRgheq )
    C( gh, Rgh %*% solve(M) )
?>
}
;

