<?R
	source("conf.R") 
	source("lib/feq.R")
	source("lib/boundary.R")

    u = PV("u", xy)
    htot = PV("htot")
    v = PV("v", xy)
    gtot = PV("gtot")

	H = PV("H")
    um = PV("um", xy)
	
	g = PV(Density$name[Density$group=='g'])
    h = PV(Density$name[Density$group=='h'])
    f = g + h

    EQ = MRT_eq(U, rho=H, J=H*um, ortogonal=FALSE)

    vf = PV("vf")

    EQh = MRT_eq(U, rho=htot, J=htot*u, ortogonal=FALSE)
    EQg = MRT_eq(U, rho=gtot, J=gtot*v, ortogonal=FALSE)

    R = PV("R",1:9-1)
    Rh = PV("Rh",1:9-1)
    Rg = PV("Rg",1:9-1)
?>

CudaDeviceFunction real_t getH(){
    RunBoundary();
	return <?R C(sum(f)) ?> ;
}
    

CudaDeviceFunction real_t getP(){
    RunBoundary();
	real_t H = <?R C(sum(f)) ?> ;
    return (H-1)/3.0;
}
 
CudaDeviceFunction real_t getVF(){
    RunBoundary();
	return (<?R C(sum(h)) ?>) / (<?R C(sum(f)) ?>) ;
}

<?R
    gJ = PV("gJ",xy)
    hJ = PV("hJ",xy)
    ngJ = PV("ngJ",xy)
    nhJ = PV("nhJ",xy)
?>

CudaDeviceFunction vector_t getU(){
    RunBoundary();
    real_t <?R C(V(gtot,htot,gJ,hJ,ngJ,nhJ),sep=",") ?>;
<?R
    C(gtot, sum(g))
    C(htot, sum(h))
    C(gJ, g %*% U[,1:2])
    C(hJ, h %*% U[,1:2])
?>
    Relax(htot/(gtot+htot), gJx, gJy, hJx, hJy, ngJx, ngJy, nhJx, nhJy);
    vector_t u;
<?R
    C(PV("u.",xyz), V(ngJ * gtot^{-1},0))
?>
	return u;
}


CudaDeviceFunction vector_t getUf(){
	real_t d = <?R C(sum(g)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), g %*% U * PV("d")^{-1}) ?>
	return u;
}

CudaDeviceFunction vector_t getUs(){
	real_t d = <?R C(sum(h)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), h %*% U * PV("d")^{-1}) ?>
	return u;
}


CudaDeviceFunction float2 Color() {
    float2 ret;
    vector_t u = getU();
    ret.x = sqrt(u.x*u.x + u.y*u.y);
    ret.y = 1.0 - getVF();
    return ret;
}

CudaDeviceFunction void SetEquilibrum(real_t H, real_t umx, real_t umy, real_t vf) {
    real_t <?R C(R,sep=", ") ?>;
<?R
    C(R, EQ$Req)
	C(g, R %*% solve(EQ$mat) * (1-vf))
    C(h, R %*% solve(EQ$mat) * vf)
?>
}

CudaDeviceFunction void Init() {
	real_t H = (1+Pressure*3);
	real_t umx = VelocityX;
	real_t umy = VelocityY;
    real_t vf = VolumeFraction; 
	SetEquilibrum(H, umx, umy, vf);
}

CudaDeviceFunction void RunBoundary() {
    switch (NodeType & NODE_BOUNDARY) {
	case NODE_WVelocity:
		WVelocity();
		break;
	case NODE_WPressure:
		WPressure();
		break;
	case NODE_EPressure:
		EPressure();
		break;
    }
}


CudaDeviceFunction void Run() {
    RunBoundary();
    switch (NodeType & NODE_COLLISION) {
    case NODE_Wall:
        BounceBack();
        break;
    case NODE_MRT:
		CollisionMRT();
        break;
    }
}

CudaDeviceFunction void BounceBack()
{
<?R FullBounceBack() ?>
}


<?R 
    EQ_b = MRT_eq(U[,1:2])
    ftmp = PV("f",i9)
?>

CudaDeviceFunction void WVelocity() {
    real_t <?R C(ftmp, sep=", ") ?>;
    real_t vf = VolumeFraction;
<?R 
    C(ftmp, g+h)
    ZouHeRewrite(EQ_b, ftmp, c(-1,0), type="velocity", PV("Velocity",c("X","Y")))
    sel = as.vector(U %*% c(-1,0,0) < 0)
    C(g[sel],(ftmp * (1-vf))[sel])
    C(h[sel],(ftmp * vf)[sel])
?>
}


CudaDeviceFunction void WPressure() {
    real_t <?R C(ftmp, sep=", ") ?>;
    real_t vf = VolumeFraction;
<?R 
    C(ftmp, g+h)
    ZouHeRewrite(EQ_b, ftmp, c(-1,0), type="pressure")
    sel = as.vector(U %*% c(-1,0,0) < 0)
    C(g[sel],(ftmp * (1-vf))[sel])
    C(h[sel],(ftmp * vf)[sel])
?>
}

CudaDeviceFunction void EPressure() {
    real_t <?R C(ftmp, sep=", ") ?>;
    real_t vf = VolumeFraction;
<?R 
    C(ftmp, g+h)
    ZouHeRewrite(EQ_b, ftmp, c(1,0), type="pressure")
    sel = as.vector(U %*% c(1,0,0) < 0)
    C(g[sel],(ftmp * (1-vf))[sel])
    C(h[sel],(ftmp * vf)[sel])
?>
}

CudaDeviceFunction void Relax(
        real_t phi,
        real_t gJx, real_t gJy, 
        real_t hJx, real_t hJy, 
        real_t& ngJx, real_t& ngJy, 
        real_t& nhJx, real_t& nhJy) {
    
    gJx = gJx*Rho +   0.5*(AccelX*Rho   + NablaPX)*(1-phi);
    gJy = gJy*Rho +   0.5*(AccelY*Rho   + NablaPY)*(1-phi);
    hJx = hJx*Rho_s + 0.5*(AccelX*Rho_s + NablaPX)*   phi;
    hJy = hJy*Rho_s + 0.5*(AccelY*Rho_s + NablaPY)*   phi;
    real_t F,G,H;
    G = (18*SlotVisc) / (PartDiam*PartDiam) * phi * Rho;
    H = (12*SlotVisc) / (Width*Width);
    if (phi < 1e-5) {
        real_t a;
        a = Rho + 0.5*H;
        ngJx = gJx / a;
        ngJy = gJy / a;
        nhJx = 0;
        nhJy = 0;
    } else if (phi < SatVolumeFraction) {
        F = Friction * phi / (SatVolumeFraction-phi);
        real_t a,b,c,d;
        a = (1-phi) * Rho   + 0.5*(H + G);
        b =               0 + 0.5*(  - G);
        c =               0 + 0.5*(  - G);
        d =    phi  * Rho_s + 0.5*(F + G);
        real_t detinv = 1.0/(a*d-b*c);
        ngJx = (1-phi) * ( d*gJx - c*hJx) * detinv;
        ngJy = (1-phi) * ( d*gJy - c*hJy) * detinv;
        nhJx =    phi  * (-b*gJx + a*hJx) * detinv;
        nhJy =    phi  * (-b*gJy + a*hJy) * detinv;
    } else {
        ngJx = 0;
        ngJy = 0;
        nhJx = 0;
        nhJy = 0;
    }
}


CudaDeviceFunction void CollisionMRT()
{
<?R
    omega = PV("omega")
    # M = EQ$mat
    # C( Rg, g %*% M )
    # C( Rh, h %*% M )
    # C( R, Rg + Rh )
    # C( H, Rg[1] + Rh[1])
    # C( um, (Rg[2:3] + Rh[2:3])*H^{-1})
    # C( vf, Rh[1]*H^{-1})
    # C( R, EQ$Req)
    # C( Rg, Rg - R*(1-vf))
    # C( Rh, Rh - R*vf)
    # C( Rg, Rg * omega)
    # C( Rh, Rh * omega)
    # C( Rg, Rg + R*(1-vf))
    # C( Rh, Rh + R*vf)
    # C( g, Rg %*% solve(M) )
    # C( h, Rh %*% solve(M) )

    Z = matrix(0,nrow(EQ$mat),ncol(EQ$mat))
    M = rbind(cbind(EQ$mat,Z),cbind(Z,EQ$mat))
    gh = V(g,h)
    Rgh = V(Rg,Rh)
    gJ = PV("gJ",xy)
    hJ = PV("hJ",xy)
    Rgh[1] = gtot
    Rgh[2:3] = gJ
    Rgh[1+9] = htot
    Rgh[2:3+9] = hJ
    Rgheq = EQ$Req
    ghvf = htot * H^{-1}
    ghum = (gJ + hJ) * H^{-1}
    #Rgheq = subst(V(EQ$Req*(1-ghvf),EQ$Req*ghvf), H=gtot+htot, umx=ghum[1], umy=ghum[2])
    Rgheq = V(
        subst(EQ$Req, H=gtot, umx=gJ[1] * H^{-1}, umy=gJ[1] * H^{-1}),
        subst(EQ$Req, H=gtot, umx=hJ[1] * H^{-1}, umy=hJ[1] * H^{-1})
    )
    Rgheq[2:3] = gJ
    Rgheq[2:3+9] = hJ
    ngJ = PV("ngJ",xy)
    nhJ = PV("nhJ",xy)
    # nRgheq = Rgheq
    nRgheq = subst(Rgheq, gJx=ngJ[1], gJy=ngJ[2], hJx=nhJ[1], hJy=nhJ[2])
    F = PV("F",xy)
?>
    
    real_t <?R C(Rgh,sep=",") ?>;
    real_t omega = 1.0 - 1.0/(3*Viscosity + 0.5);
    real_t H, vf, umx, umy;
    real_t <?R C(V(ngJ,nhJ),sep=",") ?>;
    real_t <?R C(F,sep=",") ?>;
<?R
    C( Rgh, gh %*% M )
    C( H, gtot + htot )
    C( vf, htot*H^{-1} )
    C( um, (gJ + hJ) * H^{-1} )
?>
    Relax(vf, gJx, gJy, hJx, hJy, ngJx, ngJy, nhJx, nhJy);
<?R
    C( ngJ, 2*ngJ - gJ )
    C( nhJ, 2*nhJ - hJ )
    #C( ngJ, 0.99*um * gtot )
    #C( nhJ, 0.99*um * htot )
    #C( ngJ, omega*gJ + ( 1 - omega )*um*gtot )
    #C( nhJ, omega*hJ + ( 1 - omega )*um*htot )
    #C( F, (hJ*gtot - gJ*htot) * H^{-1} )
    #C( ngJ, gJ + ( 1 - omega )*F )
    #C( nhJ, hJ - ( 1 - omega )*F )
    C( Rgh, (Rgh - Rgheq)*omega + nRgheq )
    C( gh, Rgh %*% solve(M) )
?>
}
;

