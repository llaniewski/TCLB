<?R
	source("conf.R") 
	source("lib/feq.R")
	source("lib/boundary.R")

    u = PV("u", xy)
    toth = PV("toth")
    v = PV("v", xy)
    totg = PV("totg")

	H = PV("H")
    um = PV("um", xy)
	
	g = PV(Density$name[Density$group=='g'])
    h = PV(Density$name[Density$group=='h'])
    f = g + h

    EQ = MRT_eq(U, rho=H, J=H*um, ortogonal=FALSE)

    vf = PV("vf")

    EQh = MRT_eq(U, rho=toth, J=toth*u, ortogonal=FALSE)
    EQg = MRT_eq(U, rho=totg, J=totg*v, ortogonal=FALSE)

    R = PV("R",1:9-1)
    Rh = PV("Rh",1:9-1)
    Rg = PV("Rg",1:9-1)
?>

CudaDeviceFunction real_t getH(){
	return <?R C(sum(f)) ?> ;
}
    
CudaDeviceFunction real_t getVF(){
	return (<?R C(sum(h)) ?>) / (<?R C(sum(f)) ?>) ;
}

CudaDeviceFunction vector_t getU(){
	real_t d = <?R C(sum(f)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), f %*% U * PV("d")^{-1}) ?>
    u.x += GravitationX * 0.5;
    u.y += GravitationY * 0.5;
	return u;
}


CudaDeviceFunction vector_t getUf(){
	real_t d = <?R C(sum(g)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), g %*% U * PV("d")^{-1}) ?>
	return u;
}

CudaDeviceFunction vector_t getUs(){
	real_t d = <?R C(sum(h)) ?>;
	vector_t u;
<?R C(PV("u.",xyz), h %*% U * PV("d")^{-1}) ?>
	return u;
}


CudaDeviceFunction float2 Color() {
    float2 ret;
    vector_t u = getU();
    ret.x = sqrt(u.x*u.x + u.y*u.y);
    ret.y = 1.0 - getVF();
    return ret;
}

CudaDeviceFunction void SetEquilibrum(real_t H, real_t umx, real_t umy, real_t vf) {
    real_t <?R C(R,sep=", ") ?>;
<?R
    C(R, EQ$Req)
	C(g, R %*% solve(EQ$mat) * (1-vf))
    C(h, R %*% solve(EQ$mat) * vf)
?>
}

CudaDeviceFunction void Init() {
	real_t H = (1+Pressure*3);
	real_t umx = VelocityX;
	real_t umy = VelocityY;
    real_t vf = VolumeFraction; 
	SetEquilibrum(H, umx, umy, vf);
}

CudaDeviceFunction void Run() {
    switch (NodeType & NODE_BOUNDARY) {
	case NODE_WVelocity:
		WVelocity();
		break;
	case NODE_EPressure:
		EPressure();
		break;
    }
    switch (NodeType & NODE_COLLISION) {
    case NODE_Wall:
        BounceBack();
        break;
    case NODE_MRT:
		CollisionMRT();
        break;
    }
}

CudaDeviceFunction void BounceBack()
{
<?R FullBounceBack() ?>
}


<?R 
    EQ_b = MRT_eq(U[,1:2])
    ftmp = PV("f",i9)
?>

CudaDeviceFunction void WVelocity() {
    real_t <?R C(ftmp, sep=", ") ?>;
    real_t vf = VolumeFraction;
<?R 
    C(ftmp, g+h)
    ZouHeRewrite(EQ_b, ftmp, c(-1,0), type="velocity", PV("Velocity",c("X","Y")))
    sel = as.vector(U %*% c(-1,0,0) < 0)
    C(g[sel],(ftmp * (1-vf))[sel])
    C(h[sel],(ftmp * vf)[sel])
?>
}

CudaDeviceFunction void EPressure() {
    real_t <?R C(ftmp, sep=", ") ?>;
    real_t vf = VolumeFraction;
<?R 
    C(ftmp, g+h)
    ZouHeRewrite(EQ_b, ftmp, c(1,0), type="pressure")
    sel = as.vector(U %*% c(1,0,0) < 0)
    C(g[sel],(ftmp * (1-vf))[sel])
    C(h[sel],(ftmp * vf)[sel])
?>
}


CudaDeviceFunction void CollisionMRT()
{
    real_t <?R C(R,sep=",") ?>;
    real_t <?R C(Rg,sep=",") ?>;
    real_t <?R C(Rh,sep=",") ?>;
    real_t omega = 1.0 - 1.0/(3*Viscosity + 0.5);
    real_t H, vf, umx, umy;
<?R
    omega = PV("omega")
    M = EQ$mat
    C( Rg, g %*% M )
    C( Rh, h %*% M )
    C( R, Rg + Rh )
    C( H, Rg[1] + Rh[1])
    C( um, (Rg[2:3] + Rh[2:3])*H^{-1})
    C( vf, Rh[1]*H^{-1})
    C( R, EQ$Req)
    C( Rg, Rg - R*(1-vf))
    C( Rh, Rh - R*vf)
    C( Rg, Rg * omega)
    C( Rh, Rh * omega)
    C( Rg, Rg + R*(1-vf))
    C( Rh, Rh + R*vf)
    C( g, Rg %*% solve(M) )
    C( h, Rh %*% solve(M) )
?>
}


