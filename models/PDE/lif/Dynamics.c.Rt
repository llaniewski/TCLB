<?R
    source("conf.R")
?>

CudaDeviceFunction real_t getJ() {
	return m_7[0] + m_6[0] + m_5[0] + m_4[0] + m_3[0] + m_2[0] + m_1[0];
}

CudaDeviceFunction real_t getC() {
	return Concentration;
}

CudaDeviceFunction vector_t getU() {
	vector_t u;
    u.x = m_7[1] + m_6[1] + m_5[1] + m_4[1] + m_3[1] + m_2[1] + m_1[1];
    u.y = m_7[2] + m_6[2] + m_5[2] + m_4[2] + m_3[2] + m_2[2] + m_1[2];
    u.z = m_7[3] + m_6[3] + m_5[3] + m_4[3] + m_3[3] + m_2[3] + m_1[3];
	return u;
}

CudaDeviceFunction real_t getR() {
	return resL2(0,0,0);
}

CudaDeviceFunction float2 Color() {
        float2 ret;
        vector_t u = getU();
        ret.x = sqrt(u.x*u.x + u.y*u.y);
        return ret;
}


CudaDeviceFunction void Init() {
    <?R
    C(PV(tab$field),0);
    ?>
}

CudaDeviceFunction void Run() {
    switch (NodeType & NODE_BOUNDARY) {
	case NODE_Wall:
		Wall();
		break;
    }
    if (NodeType & NODE_COLLISION)
    {
		Collision();
    }
}

CudaDeviceFunction void Wall()
{
<?R
    C(PV(tab$field),0);
?>
}

<?R
    c_table = function(x) {
        cat("\n")
        write.table(x, row.names=FALSE, col.names=FALSE, sep=", ", eol=",\n")
    }
    sph_n = length(sph_weights)
?>
const int sph_n = <?%d sph_n ?>;
CudaConstantMemory double sph_points[<?%d 3*sph_n ?>] = {<?R c_table(sph_points) ?>};
CudaConstantMemory double sph_weights[<?%d sph_n ?>] = {<?R c_table(sph_weights) ?>};




CudaDeviceFunction void chol_solve(int n, double* A, double* y) {
    for (int i=0;i<n;i++) {
        for (int k=0;k<i;k++) {
            A[i+n*i] = A[i+n*i] - A[k+n*i]*A[k+n*k]*A[k+n*i];
            y[i] = y[i] - y[k]*A[k+n*k]*A[k+n*i];
        }
        y[i] = y[i] / A[i+n*i];
        for (int j=i+1;j<n;j++) {
            for (int k=0;k<i;k++) {
                A[i+n*j] = A[i+n*j] - A[k+n*i]*A[k+n*k]*A[k+n*j];
            }
            A[i+n*j] = A[i+n*j] / A[i+n*i];
        }
    }
    for (int i=n-1;i>=0;i--) {
        for (int j=i+1;j<n;j++) {
            y[i] = y[i] - A[i+n*j] * y[j];
        }
    }
}


CudaDeviceFunction void Collision()
{
<?R
    k = length(polies)
    ms = PV(tab$field)
    dim(ms) = c(length(polies),nrow(dirs))
    m = PV("m[",1:k-1,"]")
    lam = PV("lambda[",1:k-1,"]")
?>
    const int k = <?%d k ?>;
    real_t m[k];
<?R
    C(m,ms %*% rep(1,nrow(dirs)))
?>
    real_t lambda[k]; 
    for (int j=0; j<k; j++) lambda[j] = 0;
    //lambda[0] = log(m[0]);
    for (int iter=0; iter<15; iter++) {
        real_t res[k]; 
        real_t mat[k*k];
        for (int j=0; j<k; j++) {
            res[j] = -m[j];
            for (int g=0; g<k; g++) {
                    mat[j+g*k] = 0;
            }
        }
        for (int i=0; i<sph_n; i++) {
            real_t x = sph_points[0+3*i];
            real_t y = sph_points[1+3*i];
            real_t z = sph_points[2+3*i];
            real_t poly[k];
            <?R C(PV("poly[",1:k-1,"]"), polies); ?>
            real_t a = 0;
            for (int j=0; j<k; j++) a += lambda[j]*poly[j];
            real_t b = exp(a)*sph_weights[i];
            for (int j=0; j<k; j++) {
                for (int g=j; g<k; g++) {
                    mat[j+g*k] += poly[j]*poly[g]*b;
                }
            }
        }
        /* real_t fac = m[0]/mat[0];
        lambda[0] = lambda[0]*log(fac);
        for (int j=0; j<k; j++) {
            for (int g=j; g<k; g++) {
                mat[j+g*k] = mat[j+g*k] * fac;
            }
        } */        
        for (int j=0; j<k; j++) {
            res[j] = mat[0+j*k] - m[j];
            for (int g=0; g<j; g++) {
                mat[j+g*k] = mat[g+j*k];
            }
        }
        resL2 = 0;
        for (int j=0; j<k; j++) resL2 += res[j]*res[j];
        resL2 = sqrt(resL2);

        chol_solve(k, mat, res);
        for (int j=0; j<k; j++) lambda[j] = lambda[j] - res[j];
    }
    for (int j=0; j<k; j++) {
    <?R for (i in seq_len(nrow(dirs))) { ?>
        m_<?%d i ?>[j] = 0;
    <?R } ?>
    }

    for (int i=0; i<sph_n; i++) {
        real_t x = sph_points[0+3*i];
        real_t y = sph_points[1+3*i];
        real_t z = sph_points[2+3*i];
        real_t poly[k];
        <?R C(PV("poly[",1:k-1,"]"), polies); ?>
        real_t a = 0;
        for (int j=0; j<k; j++) a += lambda[j]*poly[j];
        real_t l = exp(a) + Source;
        real_t b = l*sph_weights[i];
        real_t flux;
        for (int j=0; j<k; j++) {
            m_1[j] += poly[j]*b;
        }
        <?R for (i in seq_len(nrow(dirs))) { ?>
            flux = <?R C(PV("SpeedOfLight")*sum(PV(c("x","y","z"))*c(dirs$x[i],dirs$y[i],dirs$z[i]))) ?>;
            if (flux > 0) {
                for (int j=0; j<k; j++) {
                    m_<?%d i ?>[j] += poly[j]*b*flux;
                    m_1[j] -= poly[j]*b*flux;
                }
            }
        <?R } ?>
    }
}

