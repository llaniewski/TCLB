OPT = @CPPFLAGS@
CPP_OPT = @CPPFLAGS@
LD_OPT = @LDFLAGS@ @LIBS@
NV_OPT = -D_FORCE_INLINES  @NVFLAGS@
CPU = @CROSS_CPU@
HIP = @CROSS_HIP@

PV_SOURCE = @PV_SOURCE@
PV_BUILD = @PV_BUILD@
PV_BUILD_INC = @PV_BUILD_INC@
PV_VERSION = @PV_VERSION@
WITH_CATALYST = @WITH_CATALYST@
EMBEDED_PYTHON = @EMBEDED_PYTHON@

WITH_LAMMPS = @WITH_LAMMPS@

TOOLS = tools
RT = $(TOOLS)/RT -b
MKPATH = $(TOOLS)/mkpath
RS = R --slave --quiet --vanilla -f
TAPENADE = @TAPENADE@
ADMOD = tools/ADmod.R

RTOPT=@RTOPT@
RTOPT_ADJ=ADJOINT=1
SRC=src
DEST=CLB
AOUT = main empty compare simplepart

CP=@CP@

ifeq '$(strip $(HIP))' '1'
	NV_OPT += $(CPP_OPT)
	NVCC=hipcc
	NVCCTXT=HIPCC
	CXX=hipcc
    CXXTXT=HIPCC
else
	NV_OPT += --disable-warnings --compiler-options="$(CPP_OPT)"
	NVCC=nvcc
	NVCCTXT=NVCC
	CXX=@CXX@
	CXXTXT=C++
endif

AOUT = empty compare

ifeq '$(strip $(WITH_LAMMPS))' '1'
 AOUT += lammps
endif

