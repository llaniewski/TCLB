{
	"name": "Big (R+VTK)",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"postCreateCommand": "make configure && ./configure --disable-cuda --enable-cpu-layout --with-openmp",
	"customizations": {
		"codespaces": {
		  "openFiles": [
			"README.md"
		  ]
		}
	},
	"extensions": [
		"REditorSupport.r",
		"CFD-GO.tclb-helper"
	]
}
